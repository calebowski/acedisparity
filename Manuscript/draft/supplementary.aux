\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces \textbf  {Diagnostic plots for the aggregated continuous trait linear mixed-effects model}. Residual diagnostic plots used to assess the fit of the linear mixed-effects model fitted to the aggregated continuous trait results.}}{5}{figure.caption.5}\protected@file@percent }
\newlabel{fig:cont lmm diagnostic aggregated}{{S5}{5}{\textbf {Diagnostic plots for the aggregated continuous trait linear mixed-effects model}. Residual diagnostic plots used to assess the fit of the linear mixed-effects model fitted to the aggregated continuous trait results}{figure.caption.5}{}}
