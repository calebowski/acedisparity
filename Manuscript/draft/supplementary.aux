\newlabel{fig:discrete lmm diagnostic aggregated}{{S6}{6}{\textbf {Diagnostic plots for the aggregated discrete trait linear mixed-effects model} Residual diagnostic plots used to assess the fit of the linear mixed-effects model fitted to the aggregated discrete trait results}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S7}{\ignorespaces \textbf  {Weighted LMM continuous heatmap}. Heatmap of estimated marginal mean relative disparity errors from the weighted linear mixed-effects models for continuous traits. Values are averaged across disparity metrics and shown for each combination of estimation method, evolutionary model, and fossil sampling density.}}{6}{figure.caption.7}\protected@file@percent }
\newlabel{fig:weighted LMM continuous heatmap}{{S7}{6}{\textbf {Weighted LMM continuous heatmap}. Heatmap of estimated marginal mean relative disparity errors from the weighted linear mixed-effects models for continuous traits. Values are averaged across disparity metrics and shown for each combination of estimation method, evolutionary model, and fossil sampling density}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S8}{\ignorespaces \textbf  {Weighted LMM discrete heatmap}. Heatmap of estimated marginal mean relative disparity errors from the weighted linear mixed-effects models for discrete traits. Values are averaged across disparity metrics and shown for each combination of estimation method, transition rate, and fossil sampling density.}}{7}{figure.caption.8}\protected@file@percent }
\newlabel{fig:weighted LMM discrete heatmap}{{S8}{7}{\textbf {Weighted LMM discrete heatmap}. Heatmap of estimated marginal mean relative disparity errors from the weighted linear mixed-effects models for discrete traits. Values are averaged across disparity metrics and shown for each combination of estimation method, transition rate, and fossil sampling density}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S9}{\ignorespaces \textbf  {Continuous trait disparity error under asymmetrical trees}. Relative disparity error returned from pre-ordination point ASE (ancestral state estimation), pre-ordination distribution ASE, post-ordination point ASE, post-ordination distribution ASE and no ASE. These disparity errors were calculated across three evolutionary models (Brownian motion [BM], BM+trend and Ornstein-Uhlenbeck [OU]), five simulated fossil sampling densities (100\%, 50\%, 15\%, 5\% and 0\%) using the tip-only scheme and three disparity metrics (Sum of variances, sum of quantiles and mean pairwise distance). Values closest to 0 (dashed horizontal line) were most accurate; negative errors are under-estimates and positive are over-estimates.}}{8}{figure.caption.9}\protected@file@percent }
\newlabel{fig:Asymmetrical trees continuous boxplot}{{S9}{8}{\textbf {Continuous trait disparity error under asymmetrical trees}. Relative disparity error returned from pre-ordination point ASE (ancestral state estimation), pre-ordination distribution ASE, post-ordination point ASE, post-ordination distribution ASE and no ASE. These disparity errors were calculated across three evolutionary models (Brownian motion [BM], BM+trend and Ornstein-Uhlenbeck [OU]), five simulated fossil sampling densities (100\%, 50\%, 15\%, 5\% and 0\%) using the tip-only scheme and three disparity metrics (Sum of variances, sum of quantiles and mean pairwise distance). Values closest to 0 (dashed horizontal line) were most accurate; negative errors are under-estimates and positive are over-estimates}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S10}{\ignorespaces \textbf  {Discrete trait disparity error under asymmetrical trees}. Relative disparity error across ancestral state estimation methods and fossil sampling densities for discrete traits simulated on asymmetrical phylogenies. Results are shown for the tip-only fossil sampling scheme and are calculated across the transition rates and disparity metrics used in the main analysis. Values closer to zero indicate more accurate recovery of the true disparity. Negative values indicate underestimation and positive values indicate overestimation.}}{9}{figure.caption.10}\protected@file@percent }
\newlabel{fig:Asymmetrical trees discrete boxplot}{{S10}{9}{\textbf {Discrete trait disparity error under asymmetrical trees}. Relative disparity error across ancestral state estimation methods and fossil sampling densities for discrete traits simulated on asymmetrical phylogenies. Results are shown for the tip-only fossil sampling scheme and are calculated across the transition rates and disparity metrics used in the main analysis. Values closer to zero indicate more accurate recovery of the true disparity. Negative values indicate underestimation and positive values indicate overestimation}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S11}{\ignorespaces \textbf  {Continuous disparity error across estimation methods using the alternative tip+nodes fossil sampling scheme}. Relative disparity error returned from pre-ordination point ASE (ancestral state estimation), pre-ordination distribution ASE, post-ordination point ASE, post-ordination distribution ASE and no ASE. These disparity errors were calculated across three evolutionary models (Brownian motion [BM], BM+trend and Ornstein-Uhlenbeck [OU]), five simulated fossil sampling densities (100\%, 50\%, 15\%, 5\% and 0\%) using the `tips+nodes' scheme and three disparity metrics (Sum of variances, sum of quantiles and mean pairwise distance). Values closest to 0 (dashed horizontal line) were most accurate; negative errors are under-estimates and positive are over-estimates.}}{10}{figure.caption.11}\protected@file@percent }
\newlabel{fig:Continuous nodes tips boxplot}{{S11}{10}{\textbf {Continuous disparity error across estimation methods using the alternative tip+nodes fossil sampling scheme}. Relative disparity error returned from pre-ordination point ASE (ancestral state estimation), pre-ordination distribution ASE, post-ordination point ASE, post-ordination distribution ASE and no ASE. These disparity errors were calculated across three evolutionary models (Brownian motion [BM], BM+trend and Ornstein-Uhlenbeck [OU]), five simulated fossil sampling densities (100\%, 50\%, 15\%, 5\% and 0\%) using the `tips+nodes' scheme and three disparity metrics (Sum of variances, sum of quantiles and mean pairwise distance). Values closest to 0 (dashed horizontal line) were most accurate; negative errors are under-estimates and positive are over-estimates}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S12}{\ignorespaces \textbf  {Discrete disparity error across estimation methods using the alternative tip+nodes fossil sampling scheme}. Relative disparity error returned from pre-ordination point ASE (ancestral state estimation), pre-ordination distribution ASE, post-ordination point ASE, post-ordination distribution ASE and no ASE. These disparity errors were calculated across three transition rates (fast (0.9), medium (0.1) and slow (0.01)), five simulated fossil sampling densities (100\%, 50\%, 15\%, 5\% and 0\%) under `tips+nodes' scheme and three disparity metrics (Sum of variances, sum of quantiles and mean pairwise distance). Values closest to 0 (dashed horizontal line) were most accurate; negative errors are under-estimates and positive are over-estimates.}}{11}{figure.caption.12}\protected@file@percent }
\newlabel{fig:Discrete nodes tips boxplot}{{S12}{11}{\textbf {Discrete disparity error across estimation methods using the alternative tip+nodes fossil sampling scheme}. Relative disparity error returned from pre-ordination point ASE (ancestral state estimation), pre-ordination distribution ASE, post-ordination point ASE, post-ordination distribution ASE and no ASE. These disparity errors were calculated across three transition rates (fast (0.9), medium (0.1) and slow (0.01)), five simulated fossil sampling densities (100\%, 50\%, 15\%, 5\% and 0\%) under `tips+nodes' scheme and three disparity metrics (Sum of variances, sum of quantiles and mean pairwise distance). Values closest to 0 (dashed horizontal line) were most accurate; negative errors are under-estimates and positive are over-estimates}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S13}{\ignorespaces \textbf  {Discrete disparity error across estimation methods using the alternative tip+nodes fossil sampling scheme with common number of ordination axes across all fossil sampling densities}. Relative disparity error returned from pre-ordination point ASE (ancestral state estimation), pre-ordination distribution ASE, post-ordination point ASE, post-ordination distribution ASE and no ASE. These disparity errors were calculated across three transition rates (fast (0.9), medium (0.1) and slow (0.01)), five simulated fossil sampling densities (100\%, 50\%, 15\%, 5\% and 0\%) under the `tips+nodes' scheme and three disparity metrics (sum of variances, sum of quantiles and mean pairwise distance). Values closest to 0 (dashed horizontal line) were most accurate; negative errors are under-estimates and positive are over-estimates.}}{12}{figure.caption.13}\protected@file@percent }
\newlabel{fig:Discrete nodes tips boxplot rm axes}{{S13}{12}{\textbf {Discrete disparity error across estimation methods using the alternative tip+nodes fossil sampling scheme with common number of ordination axes across all fossil sampling densities}. Relative disparity error returned from pre-ordination point ASE (ancestral state estimation), pre-ordination distribution ASE, post-ordination point ASE, post-ordination distribution ASE and no ASE. These disparity errors were calculated across three transition rates (fast (0.9), medium (0.1) and slow (0.01)), five simulated fossil sampling densities (100\%, 50\%, 15\%, 5\% and 0\%) under the `tips+nodes' scheme and three disparity metrics (sum of variances, sum of quantiles and mean pairwise distance). Values closest to 0 (dashed horizontal line) were most accurate; negative errors are under-estimates and positive are over-estimates}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S14}{\ignorespaces Pairwise Euclidean distances between tips and nodes in true ordinations of discrete traits. Distances calculated across all axes from the 100 true discrete trait ordinations from 50-living taxa subsample.}}{13}{figure.caption.14}\protected@file@percent }
\newlabel{fig:pairwise dist discrete tip node}{{S14}{13}{Pairwise Euclidean distances between tips and nodes in true ordinations of discrete traits. Distances calculated across all axes from the 100 true discrete trait ordinations from 50-living taxa subsample}{figure.caption.14}{}}
